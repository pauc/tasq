# Homebrew formula template for tasq.
#
# Rendered by the `homebrew` job of .github/workflows/release.yml on every
# tagged release and pushed to <owner>/homebrew-tasq as Formula/tasq.rb.
# Placeholders: {{version}}, {{homepage}}, {{base_url}} (the release's
# download URL) and one {{sha256_<target>}} per tarball. Nothing else in
# this file is substituted. Install with:
#
#   brew tap <owner>/tasq
#   brew install tasq
class Tasq < Formula
  desc "Terminal task manager over nb markdown todos"
  homepage "{{homepage}}"
  version "{{version}}"
  license "GPL-3.0-or-later"

  on_macos do
    on_arm do
      url "{{base_url}}/tasq-v{{version}}-aarch64-apple-darwin.tar.gz"
      sha256 "{{sha256_aarch64_apple_darwin}}"
    end
    on_intel do
      url "{{base_url}}/tasq-v{{version}}-x86_64-apple-darwin.tar.gz"
      sha256 "{{sha256_x86_64_apple_darwin}}"
    end
  end

  on_linux do
    on_arm do
      url "{{base_url}}/tasq-v{{version}}-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "{{sha256_aarch64_unknown_linux_gnu}}"
    end
    on_intel do
      url "{{base_url}}/tasq-v{{version}}-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "{{sha256_x86_64_unknown_linux_gnu}}"
    end
  end

  def install
    bin.install "tasq"
    # Runs `tasq completions bash|zsh|fish` and installs the three scripts.
    generate_completions_from_executable(bin/"tasq", "completions")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/tasq --version")
  end
end
