# Resolves a spoken date range ("last week", "this month", "last 5 days") into
# "<from> <to>", both ISO and inclusive. Weeks run Monday-Friday; ranges never
# extend past today. Returns 1 when the words are not a known range phrase.
resolve_range() {
  local spec dow from to n
  spec=$(tr '[:upper:]' '[:lower:]' <<< "$*" | tr -s '[:space:]' ' ')
  spec="${spec# }"; spec="${spec% }"
  dow=$(date +%u)
  case "$spec" in
    "")
      from=$(date +%F); to="$from" ;;
    week|"this week"|"current week")
      from=$(date -d "$((dow - 1)) days ago" +%F); to=$(date +%F) ;;
    "last week"|"past week"|"previous week")
      from=$(date -d "$((dow + 6)) days ago" +%F)
      to=$(date -d "$((dow + 2)) days ago" +%F) ;;
    month|"this month"|"current month")
      from=$(date +%Y-%m-01); to=$(date +%F) ;;
    "last month"|"past month"|"previous month")
      from=$(date -d "$(date +%Y-%m-01) -1 month" +%F)
      to=$(date -d "$(date +%Y-%m-01) -1 day" +%F) ;;
    "last "[0-9]*" day"|"last "[0-9]*" days"|"past "[0-9]*" day"|"past "[0-9]*" days")
      n=$(awk '{ print $2 }' <<< "$spec")
      [[ "$n" =~ ^[0-9]+$ && "$n" -gt 0 ]] || return 1
      from=$(date -d "$((n - 1)) days ago" +%F); to=$(date +%F) ;;
    *)
      return 1 ;;
  esac
  printf '%s %s\n' "$from" "$to"
}

cmd_tlogs() {
  local usage="usage: tasks tlogs [<date> [<date>]] | today | yesterday | this|last week | this|last month | last <n> days"
  local arg range from="" to="" swap joined
  for arg in "$@"; do
    [[ "$arg" != -* ]] || die "$usage"
  done

  local -a parts=()
  joined="$*"
  IFS=$' \t' read -r -a parts <<< "$joined"
  if range=$(resolve_range "$@"); then
    read -r from to <<< "$range"
  elif (( ${#parts[@]} <= 2 )) && from=$(date -d "${parts[0]:-}" +%F 2>/dev/null) &&
    to=$(date -d "${parts[1]:-$from}" +%F 2>/dev/null); then
    :
  else
    from=$(date -d "$joined" +%F 2>/dev/null) || die "unrecognized date '$joined' — $usage"
    to="$from"
  fi

  if [[ "$from" > "$to" ]]; then
    swap="$from"; from="$to"; to="$swap"
  fi
  cd "$DEFAULT_WORKTREE" || die "default worktree not found: $DEFAULT_WORKTREE"
  build_claude_cmd "$DEFAULT_WORKTREE" "/time-logs $from $to"
  exec "${CLAUDE_CMD[@]}"
}

summary_raw() {
  local day="$1" id=0 fname file title done_mark notes
  while IFS= read -r fname; do
    id=$((id + 1))
    [[ "$fname" == *.todo.md && -f "$NB_HOME/$fname" ]] || continue
    file="$NB_HOME/$fname"
    title=$(head -1 "$file")
    done_mark=""
    case "$title" in
      "# [ ] "*) title=${title#"# [ ] "} ;;
      "# [x] "*) title=${title#"# [x] "}; done_mark=" (done)" ;;
      *) continue ;;
    esac
    notes=$(awk -v d="$day" '
      /^## / { ins = ($0 == "## Progress"); next }
      ins && index($0, "- " d) == 1 {
        n = substr($0, 3)
        sub("^" d "( [0-9][0-9]:[0-9][0-9])?:[ \t]*", "", n)
        if (n != "") print n
      }
    ' "$file")
    [[ -n "$notes" ]] || continue
    if [[ $(wc -l <<< "$notes") -eq 1 ]]; then
      printf -- "- [%s] %s%s — %s\n" "$id" "$title" "$done_mark" "$notes"
    else
      printf -- "- [%s] %s%s\n" "$id" "$title" "$done_mark"
      while IFS= read -r note; do
        printf -- "    - %s\n" "$note"
      done <<< "$notes"
    fi
  done < "$INDEX"
}

last_working_day() {
  local back=1
  while [[ $(date -d "$back days ago" +%u) -gt 5 ]]; do
    back=$((back + 1))
  done
  date -d "$back days ago" +%F
}

summary_prompt() {
  cat <<EOF
Below are the raw progress notes from my task tracker for $1, one top-level bullet per task (todo id in brackets, "(done)" marks completed todos). Rewrite them as a standup update I can read aloud or paste in Slack.

Split the bullets into two groups:
- First, with no heading, the tasks where I spent significant time or did relevant work that day: investigation, implementation, substantive reviews, production fixes. Judge this from the amount and depth of that day's notes, not from the task's importance.
- Then, under a single line "Also:", the small stuff that took almost no time — answering a question, a routine rebase, chasing or waiting on a review, a status check that found nothing new. One half-line bullet each, no sub-bullets. Omit the "Also:" line entirely if there is nothing small.

Rules:
- One bullet per task, leading with where it stands (merged, in review, waiting on X, blocked, done, investigating).
- Very short: aim for under 15 words per bullet; telegraphic style is fine. Drop implementation details, file paths, spec and mutation-test counts, commit shas, worktree/tooling notes, and step-by-step narration.
- Refer to MRs/issues by short reference (!1234, #1234), as a markdown link whenever the same reference appears linked anywhere in the notes — copy that URL verbatim. Never invent a URL: references that only ever appear without a link (e.g. "toolkit !438", "infra !5569") MUST stay plain text, since these live in different repos and a guessed URL points at the wrong MR.
- Drop the todo ids in brackets.
- Use sub-bullets only when a task had clearly separate pieces of work that each matter — still one short line each.
- Skip tasks with no real activity that day (notes like "created via tasks create" alone).
- Output plain markdown: no other headers, no preamble, no closing line — just the two groups of bullets.
EOF
}

render_summary() {
  local md="$1" w
  if [[ ! -t 1 ]] || ! command -v glow >/dev/null 2>&1; then
    printf '%s\n' "$md"
    return 0
  fi
  w=$(tput cols 2>/dev/null || echo 100)
  if [[ -n "${TASKS_NO_OSC8:-}" ]]; then
    printf '%s\n' "$md" | unwrap_urls "$w" | glow ${TASKS_GLOW_STYLE:+-s "$TASKS_GLOW_STYLE"} -w "$w"
    return 0
  fi
  local map
  map=$(mktemp)
  printf '%s\n' "$md" | linkify_pre "$map" |
    glow -s "${TASKS_GLOW_STYLE:-dark}" -w "$w" | linkify_post "$map"
  rm -f "$map"
}

cmd_summary() {
  local day="" raw="" arg header out
  for arg in "$@"; do
    case "$arg" in
      --raw) raw=1 ;;
      -*) die "usage: tasks summary [date] [--raw]" ;;
      *) [[ -z "$day" ]] || die "usage: tasks summary [date] [--raw]"; day="$arg" ;;
    esac
  done
  if [[ -z "$day" ]]; then
    day=$(last_working_day)
  else
    day=$(date -d "$day" +%F 2>/dev/null) || die "unrecognized date '$day' (try YYYY-MM-DD, today, yesterday)"
  fi
  header=$(date -d "$day" +'%A %F')
  out=$(summary_raw "$day")
  if [[ -z "$out" ]]; then
    echo "Nothing logged on $header."
    return 0
  fi
  if [[ -n "$raw" ]]; then
    printf "%s%s%s\n%s\n" "$BOLD" "$header" "$RESET" "$out"
    return 0
  fi
  command -v claude >/dev/null 2>&1 || die "claude CLI not found (use --raw for the unsummarized notes)"
  [[ -t 2 ]] && echo "${DIM}summarizing with claude…${RESET}" >&2
  out=$(claude -p --model "${TASKS_SUMMARY_MODEL:-sonnet}" "$(summary_prompt "$header")" <<< "$out")
  render_summary "## $header

$out"
}

cmd_log() {
  local id="${1:-}" note="${2:-}"
  [[ -n "$id" && -n "$note" ]] || die "usage: tasks log <id> <note>"
  local file
  file=$(file_for_id "$id")
  append_progress "$file" "$note"
  echo "[$id] logged: $note"
}

run_list() {
  if [[ -t 1 ]]; then
    cmd_list "$@" | ${TASKS_PAGER:-less -RFX}
  else
    cmd_list "$@"
  fi
}

[[ -n "$NB_HOME" ]] ||
  die "nb notebook '$NOTEBOOK' not found (set TASKS_NB_NOTEBOOK to an existing notebook)"
[[ -d "$NB_HOME" ]] ||
  die "notebook '$NOTEBOOK' resolved to $(printf '%q' "$NB_HOME"), which is not a directory"
if [[ ! -f "$INDEX" ]]; then
  # nb treats .index as a cache and rebuilds it lazily on any nb run, so a
  # missing index is a normal state, not an error. Rebuilding renumbers ids
  # when todos were deleted, so warn.
  nb index reconcile "$NB_HOME" >/dev/null 2>&1 || true
  [[ -f "$INDEX" ]] ||
    die "nb index not found at $INDEX, and 'nb index reconcile' could not rebuild it"
  echo "tasks: rebuilt missing nb index at $INDEX (todo ids may have changed)" >&2
fi

case "${1:-}" in
  create) shift; cmd_create "$@" ;;
  set) shift; cmd_set "$@" ;;
  log) shift; cmd_log "$@" ;;
  next) cmd_next ;;
  pick) shift; cmd_pick "$@" ;;
  done) shift; cmd_done "$@" ;;
  view) shift; cmd_view "$@" ;;
  project) shift; cmd_project "$@" ;;
  worktree) shift; cmd_worktree "$@" ;;
  session) shift; cmd_session "$@" ;;
  mr) shift; cmd_mr "$@" ;;
  update) shift; cmd_update "$@" ;;
  update-support) shift; cmd_update_support "$@" ;;
  summary) shift; cmd_summary "$@" ;;
  tlogs) shift; cmd_tlogs "$@" ;;
  -h|--help|help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
  *) run_list "${1:-}" ;;
esac
