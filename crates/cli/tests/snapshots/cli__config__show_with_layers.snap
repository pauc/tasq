---
source: crates/cli/tests/cli.rs
expression: env.normalize(&stdout(&out))
---
# profile: none
# profiles available: work
# layers, later ones win:
#   1. defaults
#   2. [ROOT]/home/.config/tasq/config.toml
#   3. [ROOT]/home/.tasq.toml
#   4. env
#   5. --set

[store]
kind = "nb"                                  # defaults
notebook = "home"                            # defaults
sync_interval = 3600                         # defaults

[workflow]
default_status = "ready"                     # defaults
statuses = ["in-progress", "ready", "waiting", "blocked", "later"] # defaults

[work]
default_project = "[ROOT]/home/code/x" # [ROOT]/home/.tasq.toml

[launch]
default = "claude"                           # defaults
detached = "auto"                            # defaults
env = "direnv"                               # defaults

[launch.claude]

[launch.herdr]
placement = "auto"                           # defaults

[ui]
detail_position = "right"                    # defaults
due_format = "relative"                      # defaults
glow_style = "light"                         # env
no_osc8 = true                               # --set
pager = "cat"                                # [ROOT]/home/.config/tasq/config.toml
week_start = "monday"                        # defaults

[ui.colors]

[ui.keys]

[ui.theme]
preset = "dark"                              # defaults

[ui.theme.colors]

[forge]

[report.summary]
command = "claude -p"                        # defaults
summarizer = "llm"                           # defaults

[hooks]
post-create = []                             # defaults
post-done = []                               # defaults
pre-launch = []                              # defaults

[worktree]
base = "origin/HEAD"                         # defaults
branch = "{{id}}-{{slug}}"                   # defaults
copies = []                                  # defaults
delete_branch = "safe"                       # defaults
enabled = false                              # defaults
on_create = "auto"                           # defaults
on_done = "release"                          # defaults
path = "{{project_parent}}/{{project_name}}-{{branch_safe}}" # defaults
symlinks = []                                # defaults
templates = []                               # defaults

[worktree.hooks]
post-create = []                             # defaults
post-remove = []                             # defaults
pre-create = []                              # defaults
pre-remove = []                              # defaults

[worktree.variables]
