---
source: crates/cli/tests/cli.rs
expression: env.normalize(&stdout(&out))
---
# profile: none
# layers, later ones win:
#   1. defaults

data_dir = "[ROOT]/home/.local/share/tasq/stores" # defaults

[store]
name = "default"                             # defaults

[workflow]
default_status = "ready"                     # defaults
statuses = ["in-progress", "ready", "waiting", "blocked", "later"] # defaults

[work]

[launch]
default = "claude"                           # defaults
env = "direnv"                               # defaults
window = "auto"                              # defaults

[launch.claude]

[launch.herdr]
placement = "auto"                           # defaults

[ui]
detail_position = "right"                    # defaults
due_format = "relative"                      # defaults
glow_style = "dark"                          # defaults
no_osc8 = false                              # defaults
pager = "less -RFX"                          # defaults
week_start = "monday"                        # defaults

[ui.colors]

[ui.keys]

[ui.theme]
preset = "dark"                              # defaults

[ui.theme.colors]

[forge]

[report.summary]
command = "claude -p"                        # defaults
summarizer = "llm"                           # defaults

[hooks]
post-create = []                             # defaults
post-done = []                               # defaults
pre-launch = []                              # defaults

[worktree]
base = "origin/HEAD"                         # defaults
branch = "{{id}}-{{slug}}"                   # defaults
copies = []                                  # defaults
delete_branch = "safe"                       # defaults
enabled = false                              # defaults
on_create = "auto"                           # defaults
on_done = "release"                          # defaults
path = "{{project_parent}}/{{project_name}}-{{branch_safe}}" # defaults
symlinks = []                                # defaults
templates = []                               # defaults

[worktree.hooks]
post-create = []                             # defaults
post-remove = []                             # defaults
pre-create = []                              # defaults
pre-remove = []                              # defaults

[worktree.variables]
