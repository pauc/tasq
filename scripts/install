#!/usr/bin/env bash
# install — reinstall the tasq and tasq-git binaries from an up-to-date main checkout.
#
# Usage: scripts/install
#
# Refuses to run unless the checkout is on main with a clean tree, fast-forwards
# main from its upstream, then runs `cargo install --locked` for crates/cli and
# crates/git (the store sync plugin) under scripts/guard. Reshims asdf when it
# manages the Rust toolchain, and prints the commit the binaries were built from.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

branch="$(git rev-parse --abbrev-ref HEAD)"
[[ "$branch" == "main" ]] || { echo "install: on '$branch', switch to main first" >&2; exit 1; }
[[ -z "$(git status --porcelain)" ]] || { echo "install: working tree is not clean" >&2; exit 1; }

git pull --ff-only
scripts/guard cargo install --path crates/cli --locked
scripts/guard cargo install --path crates/git --locked

if command -v asdf >/dev/null 2>&1; then
  asdf reshim rust
fi

echo "install: tasq built from $(git rev-parse --short HEAD) ($(git log -1 --format=%s))"
command -v tasq tasq-git
