#!/usr/bin/env sh
# Render the README gifs from docs/demo/*.tape (or the tapes given as
# arguments) with VHS running in docker, so nothing (vhs, ttyd, ffmpeg) has to
# be installed locally.
#
# Builds the debug binary first and mounts it into the container, so the gifs
# show the current tree. VHS_IMAGE overrides the image; the container runs
# as the current user so the output is not root-owned.
set -eu
cd "$(dirname "$0")/.."
scripts/guard cargo build -p tasq
[ "$#" -gt 0 ] || set -- docs/demo/*.tape
for tape in "$@"; do
    docker run --rm \
        --user "$(id -u):$(id -g)" -e HOME=/tmp \
        -v "$PWD:/vhs" \
        -v "$PWD/target/debug/tasq:/usr/local/bin/tasq:ro" \
        "${VHS_IMAGE:-ghcr.io/charmbracelet/vhs:v0.12.1}" "$tape"
done
